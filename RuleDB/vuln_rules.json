      "description": "Exchange Server ProxyLogon SSRF漏洞检测",
      "severity": "CRITICAL",
      "protocol": "HTTP",
      "transport": "TCP",
      "dst_port": 443,
      "enabled": true,
      "match_type": "STATELESS",
      "conditions": [
        { "field": "http_header_any", "op": "CONTAINS", "value": "X-AnonResource-Backend" },
        { "field": "http_uri", "op": "CONTAINS", "value": "/ecp/" }
      ],
      "action": "ALERT"
    },
    {
      "id": "VDE-010",
      "name": "ZeroLogon-CVE-2020-1472",
      "cve": "CVE-2020-1472",
      "description": "ZeroLogon Netlogon特权提升漏洞检测",
      "severity": "CRITICAL",
      "protocol": "DCERPC",
      "transport": "TCP",
      "dst_port": 445,
      "enabled": true,
      "match_type": "STATEFUL",
      "conditions": [
        { "field": "dcerpc_uuid", "op": "EQ", "value": "12345678-1234-abcd-ef00-01234567cffb", "comment": "Netlogon接口UUID" },
