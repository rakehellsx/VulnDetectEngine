{
  "version": "2.0.0",
  "description": "VulnDetectEngine漏洞特征库 - 覆盖SMB/RDP/HTTP/DNS/Kerberos/横向移动/供应链等60条规则",
  "last_updated": "2024-01-01",
  "rules": [
    {
      "id": "VDE-001",
      "name": "EternalBlue-MS17-010",
      "cve": "CVE-2017-0144",
      "description": "永恒之蓝 SMBv1 缓冲区溢出漏洞利用检测（WannaCry/NotPetya载体）",
      "severity": "CRITICAL",
      "protocol": "SMB",
      "transport": "TCP",
      "dst_port": 445,
      "enabled": true,
      "match_type": "STATEFUL",
      "conditions": [
        { "field": "smb_command", "op": "EQ", "value": "0x72", "comment": "SMB Negotiate Protocol Request" },
        { "field": "smb_version", "op": "EQ", "value": "1", "comment": "SMBv1协议" },
        { "field": "payload_pattern", "op": "HEX_MATCH", "value": "FF534D4272", "comment": "SMBv1 Negotiate魔数" }
      ],
      "follow_up": {
        "smb_command": "0x25",
        "payload_pattern": "FF534D4225",
        "max_interval_ms": 5000
      },
      "action": "ALERT",
      "references": ["https://cve.mitre.org/cgi-bin/cvename.cgi?name=CVE-2017-0144"]
    },
    {
      "id": "VDE-002",
      "name": "EternalBlue-DoublePulsar-Backdoor",
      "cve": "CVE-2017-0144",
      "description": "DoublePulsar后门植入检测 - EternalBlue利用成功后的后门通信特征",
      "severity": "CRITICAL",
      "protocol": "SMB",
      "transport": "TCP",
      "dst_port": 445,
      "enabled": true,
      "match_type": "STATELESS",
      "conditions": [
        { "field": "payload_pattern", "op": "HEX_MATCH", "value": "FF534D4272000000000098534300", "comment": "DoublePulsar ping请求特征" }
      ],
      "action": "ALERT"
    },
    {
      "id": "VDE-003",
      "name": "BlueKeep-CVE-2019-0708",
      "cve": "CVE-2019-0708",
      "description": "BlueKeep RDP远程代码执行漏洞检测 - 利用MS_T120通道UAF",
      "severity": "CRITICAL",
      "protocol": "RDP",
      "transport": "TCP",
      "dst_port": 3389,
      "enabled": true,
      "match_type": "STATEFUL",
      "conditions": [
        { "field": "rdp_channel", "op": "EQ", "value": "MS_T120", "comment": "异常MS_T120通道绑定" },
        { "field": "payload_length", "op": "GT", "value": "1024", "comment": "异常大载荷触发UAF" }
      ],
      "follow_up": {
        "payload_pattern": "4D535F543132300000",
        "max_interval_ms": 5000
      },
      "action": "ALERT"
    },
    {
      "id": "VDE-004",
      "name": "DejaBlue-CVE-2019-1181",
      "cve": "CVE-2019-1181",
      "description": "DejaBlue RDP堆溢出漏洞检测",
      "severity": "CRITICAL",
      "protocol": "RDP",
      "transport": "TCP",
      "dst_port": 3389,
      "enabled": true,
      "match_type": "STATEFUL",
      "conditions": [
        { "field": "rdp_pdu_type", "op": "EQ", "value": "0x04", "comment": "RDP Data PDU" },
        { "field": "payload_length", "op": "GT", "value": "2048", "comment": "异常载荷长度触发堆溢出" }
      ],
      "follow_up": {
        "payload_pattern": "030000",
        "max_interval_ms": 3000
      },
      "action": "ALERT"
    },
    {
